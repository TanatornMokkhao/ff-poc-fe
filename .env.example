# Every runtime setting the FE reads from config.json ("runtime"). Values here are local examples.
# The value for each stage is in ff-poc-hub config/fe/<stage>.json. The browser sees all of them,
# so none is secret: a key that must stay private belongs to the BE.
# The hub deploy checks every key here has a value before it publishes the site.
API_BASE_URL=http://localhost:3000
WS_BASE_URL=ws://localhost:3000
API_VERSION=v1
STRIPE_PUBLISH_KEY=pk_test_local
RECAPTCHA_SITE_KEY=local-site-key
GOOGLE_PLACES_API_KEY=local-places-key
DD_APP_ID=local-dd-app
DD_CLIENT_TOKEN=local-dd-token
SUPPORT_EMAIL=support+local@example.com
FEATURE_WELCOME_TOUR=true
